# Conexion administrativa: dueña de las tablas. Solo para migraciones y alta de empresas.
# El puerto es el 5433 porque asi lo publica docker-compose.yml (5433 -> 5432 del contenedor).
DATABASE_URL="pgsql:host=localhost;port=5433;dbname=resto_platform;user=resto;password=resto"

# Conexion con la que la app sirve requests, con el rol resto_app (no dueño de
# las tablas: si lo fuera, Postgres saltearia RLS y el aislamiento por tenant
# dejaria de estar protegido). Ver db/migrations/002_rls_hardening.sql.
APP_DATABASE_URL="pgsql:host=localhost;port=5433;dbname=resto_platform;user=resto_app;password=resto_app_dev"

SECRET_KEY="cambia-esto-en-produccion"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480
ENVIRONMENT="development"
API_V1_PREFIX="/api/v1"

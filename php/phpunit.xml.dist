<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true">
    <testsuites>
        <testsuite name="domain">
            <directory>tests/Domain</directory>
        </testsuite>
        <!-- No es dominio puro: mira los archivos del repositorio. Corre en la
             misma suite porque tampoco necesita base de datos. -->
        <testsuite name="core">
            <directory>tests/Core</directory>
        </testsuite>
        <!-- Contra un Postgres de verdad. Se saltan enteras si no hay base de
             pruebas configurada: ver scripts/setup-test-db.sh. -->
        <testsuite name="integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>

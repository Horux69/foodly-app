# Base de datos
# DATABASE_URL es la conexion administrativa (dueña de las tablas): migraciones
# y alta de empresas. APP_DATABASE_URL es con la que la app sirve requests y
# tiene que ser un rol que NO sea dueño, o las politicas RLS no se aplican.
DATABASE_URL=postgresql+psycopg://resto:resto@localhost:5433/resto_platform
APP_DATABASE_URL=postgresql+psycopg://resto_app:resto_app_dev@localhost:5433/resto_platform
POSTGRES_USER=resto
POSTGRES_PASSWORD=resto
POSTGRES_DB=resto_platform

# Seguridad
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# App
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
